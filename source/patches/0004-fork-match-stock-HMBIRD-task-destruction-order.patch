From c2380dfa4f838cc741d17b7ac1f59efe5378ba14 Mon Sep 17 00:00:00 2001
From: shandongtlb <40312509+shandongtlb@users.noreply.github.com>
Date: Fri, 18 Sep 2026 15:10:01 +0000
Subject: [PATCH 04/22] fork: match stock HMBIRD task destruction order

The stock jump-table entry at Image VA 0xffffffc0800aa334 identifies the android_vh_put_task hook. Its continuation calls put_dmabuf_info at 0xaa33c, hmbird_free at 0xaa344, then io_uring cleanup. Preserve this order instead of the order obtained by mechanically reversing the older HMBIRD removal.
---
 kernel/fork.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/kernel/fork.c b/kernel/fork.c
index a0b73f160..6702b5992 100755
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -1005,11 +1005,11 @@ void __put_task_struct(struct task_struct *tsk)
 	WARN_ON(refcount_read(&tsk->usage));
 	WARN_ON(tsk == current);
 
+	trace_android_vh_put_task(tsk);
+	put_dmabuf_info(tsk->dmabuf_info);
 #ifdef CONFIG_HMBIRD_SCHED
 	hmbird_free(tsk);
 #endif
-	trace_android_vh_put_task(tsk);
-	put_dmabuf_info(tsk->dmabuf_info);
 	io_uring_free(tsk);
 	cgroup_free(tsk);
 	task_numa_free(tsk, true);
