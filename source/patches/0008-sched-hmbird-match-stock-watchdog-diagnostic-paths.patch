From f409e3c366ed4cf9f8a19fc495d79b69ccaea6f4 Mon Sep 17 00:00:00 2001
From: shandongtlb <40312509+shandongtlb@users.noreply.github.com>
Date: Fri, 18 Sep 2026 17:48:29 +0000
Subject: [PATCH 08/22] sched/hmbird: match stock watchdog diagnostic paths

Use separate per-call-site ratelimits and deferred printing for the two watchdog stall diagnostics, recording exception history with the observed type index. Preserve heartbeat diagnostic behavior and remove the extra periodic entry log absent in stock.

Both ratelimit state objects match stock bytes; ARM64 build_policy relocations and history offsets verified. The retained heartbeat path deliberately uses a different exception index. Evidence: diagnostic-candidate-analysis and diagnostic-candidate-verification.
---
 kernel/sched/hmbird/hmbird.c | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/kernel/sched/hmbird/hmbird.c b/kernel/sched/hmbird/hmbird.c
index 5300bef31..bd7b32a44 100644
--- a/kernel/sched/hmbird/hmbird.c
+++ b/kernel/sched/hmbird/hmbird.c
@@ -441,6 +441,22 @@ static int l_need_rescue, b_need_rescue;
 	queue_work(system_unbound_wq, &hmbird_err_exit_work);			\
 }										\
 
+/* Stock watchdog diagnostics use a separate ratelimit per call site. */
+#define HMBIRD_FATAL_INFO_RATELIMITED_FN(type, fmt, args...) \
+do { \
+	static DEFINE_RATELIMIT_STATE(_rs, DEFAULT_RATELIMIT_INTERVAL, \
+				     DEFAULT_RATELIMIT_BURST); \
+	char buf[MAX_FATAL_INFO]; \
+	\
+	scnprintf(buf, MAX_FATAL_INFO, fmt, ##args); \
+	if (__ratelimit(&_rs)) \
+		printk_deferred("<hmbird_sched>%s\n", buf); \
+	exceps_update(md_info, type, jiffies); \
+	trace_hmbird_fatal_info((unsigned int)type, READ_ONCE(partial_enable), \
+		READ_ONCE(l_need_rescue), READ_ONCE(b_need_rescue), buf); \
+	queue_work(system_unbound_wq, &hmbird_err_exit_work); \
+} while (0)
+
 static bool cpu_same_cluster_stat(struct task_struct *p, struct rq *rq1, struct rq *rq2)
 {
 	int c1, c2;
@@ -3259,7 +3275,7 @@ static bool check_rq_for_timeouts(struct rq *rq)
 
 			rq_unlock_irqrestore(rq, &rf);
 			WRITE_ONCE(sw_type, HMBIRD_SWITCH_ERR_WDT);
-			HMBIRD_FATAL_INFO_FN(HMBIRD_EXIT_ERROR_STALL,
+			HMBIRD_FATAL_INFO_RATELIMITED_FN(HMBIRD_EXIT_ERROR_STALL,
 					"%-12s[%d] failed to run for %u.%03us, dsq=%llu, mask=%*pb",
 					p->comm, p->pid,
 					dur_ms / 1000, dur_ms % 1000,
@@ -3340,7 +3356,7 @@ void hmbird_notify_sched_tick(void)
 	if (unlikely(time_after(jiffies, last_check + hmbird_watchdog_timeout))) {
 		u32 dur_ms = jiffies_to_msecs(jiffies - last_check);
 
-		HMBIRD_FATAL_INFO_FN(HMBIRD_EXIT_ERROR_STALL,
+		HMBIRD_FATAL_INFO_RATELIMITED_FN(HMBIRD_EXIT_ERROR_STALL,
 				"watchdog failed to check in for %u.%03us",
 				dur_ms / 1000, dur_ms % 1000);
 	}
@@ -3765,7 +3781,6 @@ void hb_timer_handler(struct timer_list *timer)
 	if (!heartbeat_enable)
 		goto refill;
 
-	pr_info("<hmbird_sched>: enter timer.\n");
 	if (heartbeat) {
 		heartbeat = 0;
 		WRITE_ONCE(next_hb, jiffies + HEARTBEAT_TIMEOUT);
