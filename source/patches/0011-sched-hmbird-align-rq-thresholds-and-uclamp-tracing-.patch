From 1c2b222cc50e5ea14856fd45b89a4f7b570262ff Mon Sep 17 00:00:00 2001
From: shandongtlb <40312509+shandongtlb@users.noreply.github.com>
Date: Fri, 18 Sep 2026 18:21:37 +0000
Subject: [PATCH 11/22] sched/hmbird: align rq thresholds and uclamp tracing
 with stock

Use the stock extreme-load threshold in little filtering and util tracing. Correct uclamp traces to DEBUG_INTERNAL bit 0 and restore the signed CPU index expression observed in stock.
---
 kernel/sched/hmbird/hmbird.c | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/kernel/sched/hmbird/hmbird.c b/kernel/sched/hmbird/hmbird.c
index 9b9aaae1b..f055c3b0e 100644
--- a/kernel/sched/hmbird/hmbird.c
+++ b/kernel/sched/hmbird/hmbird.c
@@ -84,7 +84,8 @@ static void hmbird_build_clusters(void)
 
 static void hmbird_uclamp_inc(struct rq *rq, struct task_struct *p)
 {
-	unsigned int cpu = cpu_of(rq), id, value;
+	int cpu = cpu_of(rq);
+	unsigned int id, value;
 	struct hmbird_sched_cluster *cluster;
 
 	if (!uclamp_ctrl)
@@ -97,7 +98,7 @@ static void hmbird_uclamp_inc(struct rq *rq, struct task_struct *p)
 		return;
 	per_cpu(hmbird_cpu_uclamp_min_valid, cpu) = true;
 	hmbird_cpu_uclamp_min[cpu] = value;
-	hmbird_info_systrace("C|9999|Cpu_%d_uclamp_min|%u\n", cpu, value);
+	hmbird_internal_systrace("C|9999|Cpu_%d_uclamp_min|%u\n", cpu, value);
 	cluster = &hmbird_cluster[id];
 	spin_lock(&cluster->lock);
 	if (cluster->uclamp_min < value) {
@@ -112,7 +113,8 @@ static void hmbird_uclamp_inc(struct rq *rq, struct task_struct *p)
 
 static void hmbird_uclamp_dec(struct rq *rq, struct task_struct *p)
 {
-	unsigned int cpu = cpu_of(rq), id, i, value = 0;
+	int cpu = cpu_of(rq);
+	unsigned int id, i, value = 0;
 	struct hmbird_sched_cluster *cluster;
 
 	if (!uclamp_ctrl)
@@ -122,7 +124,7 @@ static void hmbird_uclamp_dec(struct rq *rq, struct task_struct *p)
 		return;
 	per_cpu(hmbird_cpu_uclamp_min_valid, cpu) = false;
 	hmbird_cpu_uclamp_min[cpu] = 0;
-	hmbird_info_systrace("C|9999|Cpu_%d_uclamp_min|%u\n", cpu, 0);
+	hmbird_internal_systrace("C|9999|Cpu_%d_uclamp_min|%u\n", cpu, 0);
 	cluster = &hmbird_cluster[id];
 	spin_lock(&cluster->lock);
 	for_each_cpu(i, &cluster->cpus)
@@ -2573,7 +2575,7 @@ static int check_misfit_task_on_little(struct task_struct *p, struct rq *rq,
 			task_util = get_hmbird_ts(p)->demand_scaled;
 	}
 
-	if (task_util <= misfit_ds)
+	if (task_util <= (extreme_load_mode ? SCHED_CAPACITY_SCALE : misfit_ds))
 		return false;
 
 	hmbird_info_trace("<filter>:task %s can't run on cpu%d, util = %llu\n",
@@ -2825,10 +2827,11 @@ static void systrace_output_cpu_ds(struct rq *rq, struct task_struct *p)
 		util = get_hmbird_ts(p)->demand_scaled;
 	util = uclamp_rq_util_with(rq, util, p);
 
-	if (util >= misfit_ds) {
+	if (util >= (extreme_load_mode ? SCHED_CAPACITY_SCALE : misfit_ds)) {
 		hmbird_internal_systrace("C|9999|cpu_%d_ds|%llu\n", cpu, util);
 		per_cpu(is_last_exceed, cpu) = true;
-	} else if (per_cpu(is_last_exceed, cpu) && (util < misfit_ds)) {
+	} else if (per_cpu(is_last_exceed, cpu) &&
+		   (util < (extreme_load_mode ? SCHED_CAPACITY_SCALE : misfit_ds))) {
 		hmbird_internal_systrace("C|9999|cpu_%d_ds|%d\n", cpu, 0);
 		per_cpu(is_last_exceed, cpu) = false;
 	} else {
